#!/usr/bin/env bash
# .githooks/pre-commit — auto-format Nix files + update dep hashes.
set -euo pipefail

CHANGED=$(git diff --cached --name-only)

# ── Step 1: format .nix files with nixfmt ──────────────────────────────
if echo "$CHANGED" | grep -qE '\.nix$'; then
  echo "⟳ Formatting .nix files with nixfmt..."
  echo "$CHANGED" | grep -E '\.nix$' | while read -r f; do
    [ -f "$f" ] && nixfmt "$f" 2>/dev/null || true
  done
  # Re-stage formatted files
  git add $(echo "$CHANGED" | grep -E '\.nix$') 2>/dev/null || true
fi

# ── Step 2: update dep hashes if needed ────────────────────────────────
needs_update() { local p=$1; echo "$CHANGED" | grep -qE "$p"; }

if needs_update 'go\.(mod|sum)|pkg/api/.*\.go|frontend/package-lock\.json|flake\.nix'; then
  echo "⟳ Dependency files changed — updating vendorHash/npmDepsHash..."
  SCRIPT="$(git rev-parse --show-toplevel)/scripts/update-hashes.sh"

  if needs_update 'go\.(mod|sum)|pkg/api/.*\.go'; then
    echo "  → vendorHash"
    "$SCRIPT" daemon 2>&1 | tail -1
  fi

  if needs_update 'frontend/package-lock\.json|flake\.nix'; then
    echo "  → npmDepsHash"
    "$SCRIPT" frontend 2>&1 | tail -1
  fi

  git add flake.nix 2>/dev/null || true
fi
